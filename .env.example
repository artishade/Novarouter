# NovaRouter environment
# SQLite path is resolved relative to prisma/schema.prisma
DATABASE_URL=file:../db/custom.db

# Or use a free Postgres provider (auto-detected in the Docker image —
# the entrypoint switches the schema provider and regenerates the client on boot):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional: point Prisma logs to stdout for debugging
# DEBUG=prisma:*
