# --------------------------------------------------------------------------- #
# NovaRouter environment (Python/FastAPI server + Python Jinja2 UI)
# --------------------------------------------------------------------------- #

# 1) Database — SQLAlchemy. Prisma-style values are accepted and normalized:
#      file:./db/custom.db                -> SQLite
#      file:/abs/path/custom.db           -> SQLite (absolute)
#      postgres://user:pass@host/db       -> PostgreSQL (Neon/Supabase/Aiven…)
#      pgbouncer/connection_limit params are stripped automatically.
DATABASE_URL=file:./db/custom.db
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 2) Public base URL (requirement #2) — every externally visible base_url
#    (meta endpoint, README examples, client snippets) points at the hosted
#    domain. When unset, the server uses the incoming request origin, which on
#    Render is your hosted domain automatically.
# PUBLIC_BASE_URL=https://novarouter.onrender.com

# 3) Server port (requirement #1) — Render assigns PORT dynamically.
#    Locally the server defaults to 3000. Never hardcode a platform port.
# PORT=10000

# 4) CORS (requirement #4) — origins allowed to call the API from browsers.
#    Comma-separated, "*" by default.
# CORS_ALLOW_ORIGINS=*

# 5) NovaFree engine sidecar (managed automatically — no need to set):
#    spawned by main.py on 127.0.0.1:3099 using bun or node when available.
# NOVA_ENGINE_PORT=3099
